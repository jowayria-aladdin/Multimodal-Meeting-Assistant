FROM python:3.10-slim

WORKDIR /app

# 1. Install system dependencies + FFmpeg Dev libraries
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswresample-dev \
    libswscale-dev \
    libsndfile1 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip

# 2. Install CPU-specific PyTorch (Prevents the +cu128 mismatch)
RUN pip install --no-cache-dir \
    torch==2.5.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cpu

# 3. Install rest of dependencies
# Note: I adjusted some versions for better stability with CPU-only torch
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    python-multipart \
    python-dotenv \
    transformers \
    accelerate \
    pyannote.audio \
    ffmpeg-python \
    soundfile \
    sentencepiece

# Copy app files
COPY asr_server.py .
COPY asr_runner.py .
COPY media_utils.py .

EXPOSE 5002

CMD ["uvicorn", "asr_server:app", "--host", "0.0.0.0", "--port", "5002"]